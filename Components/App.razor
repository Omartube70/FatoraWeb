<!DOCTYPE html>
<html lang="@_lang" dir="@_dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <meta name="author" content="Fatora POS" />
    <link rel="icon" href="/images/Icon.ico" />
    <link rel="apple-touch-icon" href="/images/Icon.ico" />

    @if (_isAdmin)
    {
        <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
        <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    }
    else
    {
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#fbfaff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0a0916" media="(prefers-color-scheme: dark)" />

        @* Applies the saved (or system) theme before the first paint so the page never flashes the wrong colours. *@
        <script>
            (function () {
                var d = document.documentElement, t = null;
                d.classList.add('fx-js');
                try { t = localStorage.getItem('fx-theme'); } catch (e) { }
                if (t !== 'light' && t !== 'dark') {
                    t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                d.setAttribute('data-theme', t);
                // If site.js never loads, don't leave the reveal-on-scroll content hidden.
                setTimeout(function () { if (!window.fx) d.classList.remove('fx-js'); }, 4000);
            })();
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

        <script type="application/ld+json">
            {
                "@@context": "https://schema.org",
                "@@type": "SoftwareApplication",
                "name": "Fatora POS",
                "description": "Smart point of sale and inventory management system | نظام كاشير ومخزون متكامل",
                "url": "https://fatorapos.com",
                "image": "https://fatorapos.com/images/cover.png",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Windows, Android",
                "inLanguage": ["ar", "en"],
                "offers": [
                    {
                        "@@type": "Offer",
                        "name": "Fatora POS - Desktop (Windows)",
                        "price": "4000",
                        "priceCurrency": "EGP"
                    },
                    {
                        "@@type": "Offer",
                        "name": "Fatora POS - Mobile (Android)",
                        "price": "2500",
                        "priceCurrency": "EGP"
                    }
                ]
            }
        </script>
    }

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["base.css"]" />
    <link rel="stylesheet" href="@Assets["site.css"]" />
    <link rel="stylesheet" href="@Assets["Fatora.styles.css"]" />
    <ImportMap />
    @* Interactive so the page title and <meta> tags follow the language when it is switched. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    @if (_isAdmin)
    {
        <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    }
    else
    {
        <script src="@Assets["site.js"]"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The admin panel keeps its own look (MudBlazor, its own RTL wrapper), so it gets none of the
    // public site's language / theme / script setup.
    private bool _isAdmin;
    private string _lang = "en";
    private string? _dir;

    protected override void OnInitialized()
    {
        _isAdmin = HttpContext?.Request.Path.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase) ?? false;
        if (_isAdmin) return;

        _lang = SiteLanguage.FromRequest(HttpContext);
        _dir = SiteLanguage.DirectionOf(_lang);
    }
}
