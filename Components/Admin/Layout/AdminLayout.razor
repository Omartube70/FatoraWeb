@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CurrentAdminService CurrentAdmin

<MudThemeProvider Theme="@ThemeProvider.GetFatoraTheme()" IsDarkMode="_isDarkMode" DefaultScrollbar="false" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<div dir="rtl">
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ms-2">Fatora POS - لوحة الإدارة</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       OnClick="ToggleTheme" Title="@(_isDarkMode ? "الوضع الفاتح" : "الوضع الداكن")" />
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <MudMenuItem Href="/admin/profile" Icon="@Icons.Material.Filled.Person">الملف الشخصي</MudMenuItem>
            <MudMenuItem Href="/admin/settings" Icon="@Icons.Material.Filled.Settings">الإعدادات</MudMenuItem>
            <MudDivider />
            <div class="px-3 py-1">
                <form method="post" action="/admin/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="admin-logout-link">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="me-2" />
                        تسجيل الخروج
                    </button>
                </form>
            </div>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" Anchor="Anchor.Right">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Fatora POS</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">الرئيسية</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1 mud-text-secondary">الإدارة</MudText>
            <MudNavLink Href="/admin/clients" Icon="@Icons.Material.Filled.People">العملاء</MudNavLink>
            <MudNavLink Href="/admin/plans" Icon="@Icons.Material.Filled.CardMembership">الباقات</MudNavLink>
            <MudNavLink Href="/admin/licenses" Icon="@Icons.Material.Filled.VpnKey">التراخيص</MudNavLink>
            <MudNavLink Href="/admin/activations" Icon="@Icons.Material.Filled.Devices">التفعيلات</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1 mud-text-secondary">التقارير</MudText>
            <MudNavLink Href="/admin/activity-log" Icon="@Icons.Material.Filled.History">سجل العمليات</MudNavLink>
            <MudNavLink Href="/admin/shift-email" Icon="@Icons.Material.Filled.MarkEmailRead">بريد ملخص الوردية</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1 mud-text-secondary">النظام</MudText>
            <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Settings">الإعدادات</MudNavLink>
            <MudNavLink Href="/admin/profile" Icon="@Icons.Material.Filled.Person">الملف الشخصي</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pa-md-6">
            <AdminBreadcrumbs />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/MainLayout.razor.js");
            var savedDarkMode = await _module.InvokeAsync<bool>("getDarkModePreference");
            if (savedDarkMode != _isDarkMode)
            {
                _isDarkMode = savedDarkMode;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        if (_module != null)
        {
            await _module.InvokeVoidAsync("saveDarkModePreference", _isDarkMode);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
