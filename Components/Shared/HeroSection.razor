@namespace Fatora.Components.Shared
@inject NavigationManager NavigationManager

<section class="hero-section" id="hero">
    <div class="hero-background-gradient"></div>
    <div class="hero-container">
        <div class="hero-content fade-in-up" style="animation-delay: 0.1s;">
            <h1 class="hero-title">
                Manage Your Business Smarter with Fatora POS
            </h1>
            <p class="hero-subtitle">
                A professional Point of Sale and Inventory Management System that helps businesses
                manage sales, inventory, suppliers, customers, reports, and cashier operations in one place.
            </p>

            <div class="hero-buttons" style="animation-delay: 0.4s;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Class="hero-btn primary-btn"
                           OnClick="@(() => ScrollToSection("download"))">
                    <div class="button-content">
                        <MudIcon Icon="@Icons.Material.Filled.GetApp" Size="Size.Small" Class="btn-icon" />
                    </div>
                    Download Free Trial
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" Class="hero-btn secondary-btn"
                           OnClick="@(() => ScrollToSection("video"))">
                    <div class="button-content">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="btn-icon" />
                    </div>
                    Watch Demo
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Medium" Class="hero-btn whatsapp-btn" Style="color: #22C55E;">
                    <div class="button-content">
                        <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" Size="Size.Small" Class="btn-icon" />
                    </div>
                    Contact on WhatsApp
                </MudButton>
            </div>
        </div>

        <div class="hero-mockup fade-in-right" style="animation-delay: 0.3s;">
            <div class="mockup-container">
                <div class="mockup-frame download-frame">
                    <div class="download-button-wrapper">
                        <div class="download-icon">
                            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" />
                        </div>
                        <h3 class="download-title">Ready to Transform Your Business?</h3>
                        <p class="download-description">Download Fatora POS and start managing your business today</p>
                        
                        <div class="download-buttons-grid">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                                       Class="download-main-button"
                                       Href="https://github.com/Omartube70/Fatora-Releases/releases/download/v1.0.0/FatoraSetup_Version_1.00.exe"
                                       Target="_blank">
                                <div class="button-content">
                                    <MudIcon Icon="@Icons.Material.Filled.Laptop" Size="Size.Small" Class="download-btn-icon" />
                                </div>
                                Windows v1.0.0
                            </MudButton>
                            
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                                       Class="download-main-button"
                                       Href="/downloads/FatoraMobile.apk"
                                       Download="FatoraMobile.apk">
                                <div class="button-content">
                                    <MudIcon Icon="@Icons.Material.Filled.Android" Size="Size.Small" Class="download-btn-icon" />
                                </div>
                                Android APK
                            </MudButton>
                        </div>

                        <div class="download-info">
                            <div class="info-item">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                <span>Fast Setup</span>
                            </div>
                            <div class="info-item">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                <span>Secure</span>
                            </div>
                            <div class="info-item">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                <span>Latest Version</span>
                            </div>
                        </div>
                        <p class="system-requirements">
                            <strong>Windows:</strong> Windows 7+, .NET 4.8 • <strong>Android:</strong> 5.0+
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" @onclick="@(() => ScrollToSection("video"))">
        <div class="mouse">
            <span class="wheel"></span>
        </div>
        <p>Scroll to explore</p>
    </div>
</section>

@code {
    private void ScrollToSection(string sectionId)
    {
        NavigationManager.NavigateTo($"#{sectionId}");
    }
}
