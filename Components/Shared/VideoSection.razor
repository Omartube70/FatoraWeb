@namespace Fatora.Components.Shared

<section class="video-section" id="video">
    <div class="video-container">
        <div class="section-header fade-in-up">
            <h2 class="section-title">Watch Fatora POS in Action</h2>
            <p class="section-subtitle">See how Fatora POS streamlines your business operations with powerful features and intuitive interface</p>
        </div>

        <div class="video-wrapper fade-in-up" style="animation-delay: 0.2s;">
            <div class="video-frame">
                <iframe 
                    src="https://www.youtube.com/embed/p37kCmY2pWk?controls=1&modestbranding=1&rel=0&showinfo=0&autoplay=0"
                    title="Fatora POS Demo"
                    class="video-player"
                    allowfullscreen
                    loading="lazy"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                </iframe>
            </div>
        </div>
    </div>
</section>

@code {
    // Video section component
}
