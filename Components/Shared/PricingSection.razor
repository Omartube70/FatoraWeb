@namespace Fatora.Components.Shared

<section class="pricing-section" id="pricing">
    <div class="pricing-container">
        <div class="section-header fade-in-up">
            <span class="section-badge">💰 TRANSPARENT PRICING</span>
            <h2 class="section-title">Simple, Honest, Professional</h2>
            <p class="section-subtitle">One single price with everything included. No hidden fees. No surprises. Just pure value.</p>
        </div>

        <div class="pricing-wrapper fade-in-up" style="animation-delay: 0.2s;">
            <!-- Pricing Card -->
            <div class="pricing-card-main">
                <!-- Top Badge -->
                <div class="pricing-top-badge">
                    <span class="badge-text">🏆 BEST VALUE</span>
                </div>

                <!-- Price Display -->
                <div class="price-display">
                    <div class="price-box">
                        <div class="price-header">
                            <span class="currency-symbol">E£</span>
                            <span class="amount">4,000</span>
                        </div>
                    </div>
                    <div class="price-label">
                        <span class="label">One-time Payment</span>
                        <span class="sublabel">Forever • No Subscriptions • Lifetime Updates</span>
                    </div>
                </div>

                <!-- Divider -->
                <div class="price-divider"></div>

                <!-- Features List -->
                <div class="features-list">
                    <h4 class="features-heading">✨ Everything Included:</h4>
                    <ul class="features-items">
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="feature-icon" />
                            <span>Lifetime License</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.AllInclusive" Class="feature-icon" />
                            <span>All Features Included</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.SystemUpdate" Class="feature-icon" />
                            <span>Free Lifetime Updates</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Class="feature-icon" />
                            <span>24/7 Priority Support</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.SecurityUpdate" Class="feature-icon" />
                            <span>Free Security Updates</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="feature-icon" />
                            <span>Offline Mode Support</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="feature-icon" />
                            <span>Professional POS System</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Class="feature-icon" />
                            <span>SQL Server Database</span>
                        </li>
                        <li class="feature-row">
                            <MudIcon Icon="@Icons.Material.Filled.Translate" Class="feature-icon" />
                            <span>Arabic & English Interface</span>
                        </li>
                    </ul>
                </div>

                <!-- CTA Button -->
                <div class="pricing-button-wrapper">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true" Class="pricing-main-button" Href="https://api.whatsapp.com/send?phone=201080197811&source=FB_Post&token=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IjEyNSJ9..FHrSsSndXNfgwcQTJADcqunNg00VCRdKr3g_Rs_l-7A4DPB4mM2zDNfmWOtAhKTMzV1RtfWrA-HBRWTrZphNMg&fbclid=IwY2xjawTSACpleHRuA2FlbQIxMQBzcnRjBmFwcF9pZBAyMjIwMzkxNzg4MjAwODkyAAEeMqV1i2l90Ubox_fPy2HWkt2QpWeaPHmNEM8kvU0b-12wBap1D00efV6r6Pw_aem_I3eE2Yb2tE-Deij0Ebjyhg" Target="blank">
                        <div class="button-content">
                            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Small" Class="button-icon" />
                        </div>
                        Start Your Free Trial Now
                    </MudButton>
                    <p class="button-note">✓ 7 days full access • ✓ No credit card needed • ✓ Cancel anytime</p>
                </div>
            </div>

            <!-- Info Cards -->
            <div class="pricing-info-cards">
                <div class="info-card">
                    <h4>⏰ Limited Time</h4>
                    <p>Lock in the best price now with lifetime updates included</p>
                </div>

                <div class="info-card">
                    <h4>🔒 100% Secure</h4>
                    <p>Enterprise-grade security with money-back guarantee</p>
                </div>

                <div class="info-card">

                    <h4>🎯 Expert Support</h4>
                    <p>24/7 priority support to help you succeed</p>
                </div>
            </div>
        </div>
    </div>
</section>

