@namespace Fatora.Components.Shared
@inject DesktopReleaseService DesktopReleases
@inject DateService Dates

<section class="download-section" id="download">
    <div class="download-container">
        <h2 class="section-title">Download Fatora POS@(VersionTag)</h2>
        <p class="section-subtitle">Official Stable Release - Get started with your free 7-day trial</p>

        <div class="download-info-grid">
            <div class="info-card">
                <h3>Desktop Version</h3>
                <p>@(_latest is null ? "Windows" : $"v{_latest.Version} - Windows")</p>
            </div>

            <div class="info-card">
                <h3>Mobile Version</h3>
                <p>Android APK - 85 MB</p>
            </div>

            <div class="info-card">
                <h3>Release Date</h3>
                <p>@(_latest is null ? "—" : Dates.FormatDate(_latest.PublishedAt))</p>
            </div>

            <div class="info-card">
                <h3>System Requirements</h3>
                <p>Windows 7+ / Android 5.0+</p>
            </div>
        </div>

        <div class="download-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium" Class="download-btn"
                       Href="@(_latest?.InstallerUrl ?? DesktopReleases.LatestReleasePageUrl)"
                       Target="_blank">
                <div class="button-content">
                    <MudIcon Icon="@Icons.Material.Filled.GetApp" Size="Size.Small" Class="btn-icon" />
                    Download@(VersionTag) (Windows)
                </div>
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium" Class="download-btn"
                       Href="/downloads/FatoraMobile.apk"
                       Download="FatoraMobile.apk">
                <div class="button-content">
                    <MudIcon Icon="@Icons.Material.Filled.Android" Size="Size.Small" Class="btn-icon" />
                    Download Android App
                </div>
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" Class="download-btn"
                       Href="@(_latest?.PageUrl ?? DesktopReleases.LatestReleasePageUrl)"
                       Target="_blank">
                <div class="button-content">
                    <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="btn-icon" />
                    Release Notes
                </div>
            </MudButton>
        </div>

        <div class="release-features">
            <h3 class="features-title">✨ What's Included@(VersionTag)</h3>
            <ul class="features-list">
                <li><span class="feature-badge">💰</span> Complete Sales & Cashier System with Barcode Scanner support</li>
                <li><span class="feature-badge">📦</span> Smart Inventory Management with low stock alerts</li>
                <li><span class="feature-badge">🤝</span> Supplier & Purchase Management with automatic stock updates</li>
                <li><span class="feature-badge">📊</span> Interactive Dashboard with real-time analytics</li>
                <li><span class="feature-badge">👥</span> Role-Based Access Control for team management</li>
                <li><span class="feature-badge">🛡️</span> Enterprise-grade security with SQL Server backend</li>
                <li><span class="feature-badge">🌍</span> Full Arabic & English interface support</li>
                <li><span class="feature-badge">🖨️</span> Thermal printer support for receipt printing</li>
            </ul>
        </div>

        <div class="installation-guide">
            <h3 class="guide-title">📥 Installation Steps</h3>
            <ol class="guide-steps">
                <li>Download <strong>@(_latest?.InstallerName ?? "the Fatora setup file")</strong> from the button above</li>
                <li>Extract <strong>Fatora-Database-Scripts.zip</strong> from GitHub releases</li>
                <li>Ensure .NET Framework 4.8 and SQL Server 2019 Express are installed</li>
                <li>Run the installer and follow the setup wizard</li>
                <li>Default credentials: <strong>Username: Admin</strong>, <strong>Password: Admin@123</strong></li>
                <li>Change your password immediately after first login</li>
            </ol>
        </div>

        @if (_releases.Count > 0)
        {
            <div class="version-history">
                <h3 class="history-title">📝 Release History</h3>
                <ul class="history-list">
                    @foreach (var release in _releases)
                    {
                        <li class="history-item">
                            <span class="version-badge @(release == _latest ? "latest" : "")">v@(release.Version)</span>
                            <span class="date">@Dates.FormatDate(release.PublishedAt)</span>
                            <span class="notes">@release.Name</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

@code {
    // The desktop links and version come from the newest GitHub release, never typed by hand
    private IReadOnlyList<DesktopRelease> _releases = [];
    private DesktopRelease? _latest;

    private string VersionTag => _latest is null ? "" : $" v{_latest.Version}";

    protected override async Task OnInitializedAsync()
    {
        _releases = await DesktopReleases.GetReleasesAsync();
        _latest = _releases.FirstOrDefault();
    }
}
