@namespace Fatora.Components.Shared

<section class="features-section" id="features">
    <div class="features-container">
        <h2 class="section-title">Powerful Features</h2>
        <p class="section-subtitle">Everything you need to manage your business efficiently</p>

        <div class="features-grid">
            <FeatureCard 
                Icon="@Icons.Material.Filled.AttachMoney" 
                Title="💳 Fast Cashier" 
                Description="Quick and intuitive cashier interface optimized for speed and accuracy" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Code" 
                Title="📦 Barcode Support" 
                Description="Seamless barcode scanning and product identification" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Storage" 
                Title="🏭 Inventory Management" 
                Description="Real-time inventory tracking and stock level alerts" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.ShoppingCart" 
                Title="🛒 Purchase Management" 
                Description="Streamlined purchasing and supplier order management" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Groups" 
                Title="🤝 Supplier Management" 
                Description="Complete supplier database and relationship management" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.PersonPin" 
                Title="👥 Customer Management" 
                Description="Detailed customer profiles and loyalty tracking" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Assessment" 
                Title="📊 Sales Reports" 
                Description="Comprehensive sales analytics and reporting tools" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.ShowChart" 
                Title="📈 Profit Reports" 
                Description="Detailed profit margin analysis and trends" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Dashboard" 
                Title="⚡ Dashboard Analytics" 
                Description="Real-time business insights and KPI monitoring" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.VerifiedUser" 
                Title="🔐 User Permissions" 
                Description="Granular access control and role-based security" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.CloudSync"
                Title="Automatic Backup" 
                Description="Secure automated data backup and recovery" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Print" 
                Title="Thermal Printer Support" 
                Description="Direct thermal printer integration for receipts" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.SignalCellularAlt" 
                Title="Offline Mode" 
                Description="Continue operations without internet connection" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Storage" 
                Title="SQL Server Database" 
                Description="Enterprise-grade database for reliability and performance" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Translate" 
                Title="Arabic Interface" 
                Description="Full Arabic language support and localization" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.Lock" 
                Title="High Security" 
                Description="Advanced encryption and data protection measures" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.AdminPanelSettings" 
                Title="Role Based Access" 
                Description="Customizable roles and permissions system" />

            <FeatureCard 
                Icon="@Icons.Material.Filled.FlightTakeoff" 
                Title="Fast Performance" 
                Description="Optimized for speed and responsiveness" />
        </div>
    </div>
</section>

