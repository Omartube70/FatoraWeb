@namespace Fatora.Components.Shared

<section class="trial-section" id="trial">
    <div class="trial-container">
        <div class="trial-content">
            <h2 class="section-title fade-in-up">Ready to Transform Your Business?</h2>
            <p class="section-subtitle fade-in-up" style="animation-delay: 0.1s;">
                Start your free 7-day trial today and experience the power of Fatora POS
            </p>

            <!-- Trial Benefits Grid -->
            <div class="trial-grid">
                <div class="trial-benefit fade-in-up" style="animation-delay: 0.2s;">
                    <div class="benefit-number">7</div>
                    <h3>Days Free</h3>
                    <p>Full access to all premium features</p>
                </div>

                <div class="trial-benefit fade-in-up" style="animation-delay: 0.3s;">
                    <div class="benefit-number">∞</div>
                    <h3>Full Features</h3>
                    <p>No limitations or restrictions</p>
                </div>

                <div class="trial-benefit fade-in-up" style="animation-delay: 0.4s;">
                    <div class="benefit-number">0</div>
                    <h3>No Credit Card</h3>
                    <p>Start instantly, no payment required</p>
                </div>

                <div class="trial-benefit fade-in-up" style="animation-delay: 0.5s;">
                    <div class="benefit-number">✓</div>
                    <h3>Instant Setup</h3>
                    <p>Get started in less than 5 minutes</p>
                </div>
            </div>

            <!-- CTA Buttons -->
            <div class="trial-ctas fade-in-up" style="animation-delay: 0.6s;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Class="trial-button primary">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                    Download Free Trial
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" Class="trial-button secondary">
                    <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
                    Watch Demo
                </MudButton>
            </div>

            <!-- Trust Badges -->
            <div class="trial-trust fade-in-up" style="animation-delay: 0.7s;">
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                    <span>SSL Secured</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                    <span>Money-Back Guarantee</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                    <span>No Auto-Renewal</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    // Trial section component
}
}
