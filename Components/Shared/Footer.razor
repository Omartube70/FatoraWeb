@namespace Fatora.Components.Shared

<footer class="footer-section">
    <div class="footer-container">
        <div class="footer-grid">
            <!-- Logo & Brand -->
            <div class="footer-brand">
                <h3 class="footer-logo">
                    <img src="/images/Icon.ico" alt="Fatora Logo" class="footer-logo-img" />
                    Fatora
                </h3>
                <p class="footer-tagline">Smart Point of Sale & Inventory Management System</p>
                <div class="footer-socials">
                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Link="https://facebook.com" Target="_blank" Class="social-icon" />
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Link="https://github.com" Target="_blank" Class="social-icon" />
                    <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp" Link="https://wa.me/20XXXXXXXXXX" Target="_blank" Class="social-icon" />
                </div>
            </div>

            <!-- Quick Links -->
            <div class="footer-column">
                <h4>Product</h4>
                <ul class="footer-links">
                    <li><a href="#features">Features</a></li>
                    <li><a href="#pricing">Pricing</a></li>
                    <li><a href="#gallery">Gallery</a></li>
                    <li><a href="#faq">FAQ</a></li>
                </ul>
            </div>

            <!-- Company Links -->
            <div class="footer-column">
                <h4>Company</h4>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/privacy">Privacy Policy</a></li>
                    <li><a href="/terms">Terms of Use</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div class="footer-column">
                <h4>Support</h4>
                <ul class="footer-links">
                    <li><a href="mailto:support@fatora.com">Email Support</a></li>
                    <li><a href="https://wa.me/20XXXXXXXXXX">WhatsApp</a></li>
                    <li><a href="#faq">FAQ</a></li>
                    <li><a href="#download">Documentation</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom">
            <p>&copy; 2024 Fatora POS. All rights reserved.</p>
            <div class="footer-links-bottom">
                <a href="/privacy">Privacy Policy</a>
                <span class="divider">•</span>
                <a href="/terms">Terms of Use</a>
            </div>
        </div>
    </div>
</footer>

