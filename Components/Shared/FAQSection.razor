@namespace Fatora.Components.Shared

<section class="faq-section" id="faq">
    <div class="faq-container">
        <div class="section-header fade-in-up">
            <span class="section-badge">❓ NEED HELP?</span>
            <h2 class="section-title">Frequently Asked Questions</h2>
            <p class="section-subtitle">Everything you need to know about Fatora POS. Can't find an answer? Our support team is here to help.</p>
        </div>

        <div class="faq-list">
            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="💰 What is the price of Fatora POS?">
                    <p class="faq-answer">Fatora POS is offered at a one-time payment of <strong>4,000 EGP</strong>. This gives you a lifetime license with free updates and technical support. No hidden fees, no subscriptions, no surprise charges.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="🎁 Is there a free trial available?">
                    <p class="faq-answer">Yes! We offer a <strong>7-day free trial</strong> with full access to all features. No credit card is required. You can download and start using Fatora POS immediately and experience all its capabilities risk-free.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="📡 Does Fatora POS require internet connection?">
                    <p class="faq-answer">Fatora POS can work <strong>completely offline!</strong> You can continue processing sales and managing your business even without internet. Data will sync automatically when connection is restored, so you never lose important information.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="⚙️ What are the system requirements?">
                    <p class="faq-answer">Fatora POS requires:</p>
                    <ul class="faq-requirements">
                        <li>Windows 7 SP1 or higher</li>
                        <li>.NET 6 or higher</li>
                        <li>SQL Server (Express or higher)</li>
                        <li>~450 MB disk space for installation</li>
                    </ul>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="🌍 Is Fatora POS available in Arabic?">
                    <p class="faq-answer">Yes! Fatora POS has <strong>full Arabic language support</strong> with complete localization. You can seamlessly switch between English and Arabic from the settings without restarting the application.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="🖨️ Does Fatora POS support thermal printers?">
                    <p class="faq-answer"><strong>Yes!</strong> Fatora POS has built-in support for thermal printers. You can print receipts directly to thermal printers connected to your system with professional formatting.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="💾 How is my data backed up?">
                    <p class="faq-answer">Fatora POS includes <strong>automatic backup functionality</strong> with advanced encryption. Your data is securely backed up regularly, and you can perform manual backups at any time. Your business data is always protected.</p>
                </MudExpansionPanel>
            </div>

            <div class="faq-item fade-in-up">
                <MudExpansionPanel Text="👥 Can multiple users use Fatora POS with different permissions?">
                    <p class="faq-answer"><strong>Absolutely!</strong> Fatora POS has a comprehensive role-based access control system. You can create multiple user accounts with different permissions and access levels for your team members, ensuring proper security and accountability.</p>
                </MudExpansionPanel>
            </div>
        </div>

        <!-- Support CTA -->
        <div class="faq-support-section">
            <h3 class="faq-cta-title">Still have questions?</h3>
            <p class="faq-cta-text">Our dedicated support team is available 24/7 to help you get the most out of Fatora POS.</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">
                <div class="button-content">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="button-icon" />
                </div>
                Contact Support
            </MudButton>
        </div>
    </div>
</section>

@code {
    // FAQ section component
}
