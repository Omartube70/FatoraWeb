@namespace Fatora.Components.Site

<svg class="fx-i @Class" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">@((MarkupString)Path)</svg>

@code {
    /// <summary>One of the MudBlazor <c>Icons.*</c> constants (SVG markup).</summary>
    [Parameter, EditorRequired] public string Path { get; set; } = "";

    [Parameter] public string? Class { get; set; }
}
