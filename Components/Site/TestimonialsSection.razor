@namespace Fatora.Components.Site
@inherits FxComponentBase

<section class="fx-section fx-testimonials" id="testimonials" data-spy="testimonials">
    <div class="fx-container">
        <SectionHead Kicker="@T("عملاؤنا", "Our customers")"
                     Title="@T("عملاء حقيقيون، وآراء حقيقية", "Real customers, real feedback")"
                     Subtitle="@T("محلات ومطاعم حقيقية تعمل بفاتورة كل يوم، وهذه صور من أماكن عملهم.", "Shops and restaurants running Fatora in their daily work — these are photos from their counters.")" />

        <div class="fx-tgrid">
            @for (var i = 0; i < Clients.Length; i++)
            {
                var c = Clients[i];
                <figure class="fx-client" data-reveal data-spot style="--d:@((i * 0.08).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))s;--c:var(--c-@c.Tone)">
                    <div class="fx-client__media">
                        <div class="fx-client__photo">
                            <img src="/images/clients/@c.Main" alt="@T(c.MainAltAr, c.MainAltEn)" style="object-position:@c.MainPosition"
                                 width="1600" height="1100" loading="lazy" />
                        </div>
                        <img class="fx-client__inset" src="/images/clients/@c.Inset" alt="@T(c.InsetAltAr, c.InsetAltEn)" style="object-position:@c.InsetPosition"
                             width="400" height="500" loading="lazy" />
                    </div>

                    <div class="fx-client__body">
                        <div class="fx-client__head">
                            <h3>@T(c.NameAr, c.NameEn)</h3>
                            <span class="fx-tag">@T(c.KindAr, c.KindEn)</span>
                        </div>

                        @if (c.QuoteAr is not null && c.QuoteEn is not null)
                        {
                            <blockquote class="fx-client__quote">@T(c.QuoteAr, c.QuoteEn)</blockquote>
                        }
                        else
                        {
                            <p class="fx-client__note">@T(c.NoteAr, c.NoteEn)</p>
                        }

                        <figcaption class="fx-client__who">@T(c.WhoAr, c.WhoEn)</figcaption>
                    </div>
                </figure>
            }
        </div>
    </div>
</section>

@code {
    // Real customers: the photos come from their shops, and the quotes are their own words (see wwwroot/images/clients).
    // A customer who hasn't left a written opinion (yet) gets a plain description of the photo instead of an invented quote.
    private record Client(
        string Tone,
        string NameAr, string NameEn,
        string KindAr, string KindEn,
        string? QuoteAr, string? QuoteEn,
        string NoteAr, string NoteEn,
        string WhoAr, string WhoEn,
        string Main, string MainPosition, string MainAltAr, string MainAltEn,
        string Inset, string InsetPosition, string InsetAltAr, string InsetAltEn);

    private static readonly Client[] Clients =
    [
