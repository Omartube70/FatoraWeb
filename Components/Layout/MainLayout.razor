@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject PersistentComponentState PersistedState

<HeadContent>
    <meta name="description" content="@T("فاتورة: نظام كاشير ومخزون احترافي لإدارة المبيعات والمخزون والعملاء والموردين والتقارير، ويعمل حتى بدون إنترنت.", "Fatora POS - a professional point of sale and inventory system for sales, stock, customers, suppliers and reports. Works even offline.")" />
    <meta name="keywords" content="@T("نظام كاشير, برنامج كاشير, برنامج مخازن, نقاط البيع, إدارة المخزون, فاتورة", "POS system, point of sale, inventory management, cashier software, Fatora")" />
    <meta property="og:title" content="@PageTitleText" />
    <meta property="og:description" content="@T("نظام كاشير ومخزون متكامل: إدارة أسهل، أرباح أكثر.", "A complete POS and inventory system: easier management, more profit.")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fatorapos.com" />
    <meta property="og:image" content="https://fatorapos.com/images/cover.png" />
    <meta property="og:image:width" content="1774" />
    <meta property="og:image:height" content="887" />
    <meta property="og:site_name" content="Fatora POS" />
    <meta property="og:locale" content="@T("ar_EG", "en_US")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@PageTitleText" />
    <meta name="twitter:image" content="https://fatorapos.com/images/cover.png" />
</HeadContent>

<CascadingValue Name="FxLang" Value="_lang">
    <div class="fx">
        <div class="fx-progress" aria-hidden="true"></div>

        <SiteNav OnToggleLanguage="ToggleLanguage" />

        <main class="fx-main" id="top">
            @Body
        </main>

        <SiteFooter />
        <FloatingActions />
    </div>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    @T("حدث خطأ غير متوقع.", "An unhandled error has occurred.")
    <a href="." class="reload">@T("إعادة التحميل", "Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string StateKey = "fx-lang";

    private string _lang = SiteLanguage.Arabic;
    private PersistingComponentStateSubscription _persistence;

    private string PageTitleText => T("فاتورة POS | نظام كاشير ومخزون متكامل", "Fatora POS | Point of Sale & Inventory Management");

    private string T(string ar, string en) => _lang == SiteLanguage.Arabic ? ar : en;

    // The language chosen in the cookie is read while the page is server-rendered, then carried over
    // to the interactive circuit through persisted state so the text doesn't change after load.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (PersistedState.TryTakeFromJson<string>(StateKey, out var saved) && saved is not null)
        {
            _lang = SiteLanguage.Normalize(saved);
        }
        else
        {
            _lang = SiteLanguage.FromRequest(HttpContext);
        }

        _persistence = PersistedState.RegisterOnPersisting(() =>
        {
            PersistedState.PersistAsJson(StateKey, _lang);
            return Task.CompletedTask;
        }, RenderMode.InteractiveServer);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // No server-rendered cookie to go by (e.g. the circuit started without prerendering): ask the browser.
        try
        {
            var stored = await JS.InvokeAsync<string?>("fx.getLang");
            if (stored is not null && SiteLanguage.Normalize(stored) != _lang)
            {
                _lang = SiteLanguage.Normalize(stored);
                await JS.InvokeVoidAsync("fx.setLang", _lang);
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // site.js isn't loaded on this page (a 404 reached under /admin): nothing to sync.
        }
    }

    private async Task ToggleLanguage()
    {
        _lang = _lang == SiteLanguage.Arabic ? SiteLanguage.English : SiteLanguage.Arabic;
        try
        {
            await JS.InvokeVoidAsync("fx.setLang", _lang);
        }
        catch (JSException)
        {
            // Same as above - the text still switches, only the cookie / direction update is missed.
        }
    }

    public void Dispose() => _persistence.Dispose();
}
